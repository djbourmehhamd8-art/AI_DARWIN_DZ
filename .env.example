# ===== مطلوب =====
TELEGRAM_TOKEN=
API_KEY=
# مفاتيح إضافية من نفس المزوّد (احتياطية): عند تعطل مفتاح ينتقل البوت تلقائياً للتالي.
# افصل بفاصلة، أو استخدم API_KEY_2 و API_KEY_3 ...
# API_KEYS=key2,key3,key4
# API_KEY_2=
# KEY_STRATEGY=failover      # failover = مفتاح ثابت حتى يعطل | roundrobin = توزيع الحمل بالتناوب

# ===== الوصول =====
# معرّفات المديرين (افصل بفاصلة). أرسل /id للبوت لمعرفة معرّفك
ADMIN_IDS=
# مستخدمون مسموح لهم (اختياري). يمكن للمدير إضافة آخرين بالأمر /allow
ALLOWED_IDS=
# true = أي شخص يستطيع استخدام البوت (احذر: يستهلك رصيدك)
PUBLIC=false

# ===== أمن DARWIN DZ =====
# حجب المفاتيح/التوكنات/المفاتيح الخاصة قبل حفظها أو إرسالها للنموذج (موصى به)
# SECRET_GUARD=true
# فحص كلمة المرور في /pass عبر HIBP بأسلوب k-anonymity (يُرسل 5 أحرف من SHA-1 فقط)
# HIBP=true

# ===== الخصوصية =====
# حذف سجل المحادثات الأقدم من N يوماً تلقائياً (0 = احتفاظ دائم)
# RETENTION_DAYS=30

# ===== اختياري =====
# DAILY_LIMIT=0        # حد الرسائل اليومي لكل مستخدم (0 = بدون حد)
# GROUPS=false         # السماح بالرد داخل المجموعات
# API_BASE_URL=https://api.aiwithnorestrictions.com/v1
# MODEL=notrack-uncensored
# API_PERSONA=bare       # bare|notrack|concise|detailed|creative; bare uses DARWIN's own system prompt
# DEFAULT_LANG=ar
# DEFAULT_TEMP=0.5
# DEFAULT_PERSONA=default   # default|soc|dfir|intel|appsec|pentest|grc|awareness|coder|writer|teacher
# SYSTEM_PROMPT=
# MAX_HISTORY=20
# RATE_LIMIT=12
# STREAM=true
# STREAM_INTERVAL=1.0
# WORKERS=8
# AI_TIMEOUT=120
# AI_RETRIES=2
# LOG_LEVEL=INFO

# --- Web search (v3.7) ---
# WEB_SEARCH=true          # false = disable web search for everyone
# WEB_DEFAULT=auto         # default per-user mode: off | auto | on
# WEB_RESULTS=5            # search results used per answer (1-10)
# WEB_PAGES=2              # result pages read for excerpts (0 = snippets only)
# BUTTON_COLORS=1          # 0 = plain (uncoloured) buttons

# --- Access and groups (v3.9) ---
# CONTACT=DARWIN0DZ          # owner account shown on the "private bot" screen (without @)
# GROUPS=true                # answer inside groups
# GROUP_OPEN=false           # true = answer in ANY group; false = an admin must activate each group
# GROUP_TRIGGERS=dz,دي زد    # words that address the bot at the start of a group message
# GROUP_MEMBER_LIMIT=30      # daily questions for group members who have no personal access (0 = unlimited)

# --- Limits, search, report (v4.1) --- (DAILY_LIMIT above is the default per user and can be changed live in the admin panel)
# GROUP_DAILY_LIMIT=0          # default messages per GROUP per day (0 = unlimited); editable per group from the panel
# BRAVE_API_KEY=               # most reliable web search on a VPS (free key: https://brave.com/search/api)
# SEARXNG_URL=                 # or your own SearXNG instance, e.g. https://searx.example.org
# DIGEST_HOUR=-1               # local hour 0-23 for the daily admin report, -1 = off
